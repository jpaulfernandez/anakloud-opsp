# Align — environment template.
#
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# This template contains no secret values — the connection strings below are
# placeholders showing the URL shape, not real credentials. Keep it that way.

# --- Database (Neon by default; local Docker is the offline fallback) ---

# Pooled endpoint — used for request-path connections. Neon's pooled endpoint
# terminates at the transaction pooler. sslmode=require is mandatory.
#   DATABASE_URL=postgresql://<user>:<password>@<branch>--ep-…-pooler…neon.tech/<db>?sslmode=require
DATABASE_URL=

# Direct endpoint — used for migrations only. Migrations hold a session-scoped
# advisory lock, which is unreliable through the pooler, so they must use the
# direct endpoint (F17-T01). sslmode=require is mandatory.
#   DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<branch>--ep-…neon.tech/<db>?sslmode=require
# If unset, migrations fall back to DATABASE_URL and log a warning.
DATABASE_URL_UNPOOLED=

# Offline fallback without Neon: keep the existing Docker container
# (anakloud-e2e-pg, port 5435) and point both variables at it:
#   DATABASE_URL=postgresql://align:align@localhost:5435/alignedb
#   DATABASE_URL_UNPOOLED=postgresql://align:align@localhost:5435/alignedb
#   (You can leave DATABASE_URL_UNPOOLED unset — migrations fall back.)

# AI provider key. OPTIONAL: its absence is non-fatal and the product runs
# fully deterministic-only (PR3); nothing above debug is logged without it.
GEMINI_API_KEY=

# Pinned model id — never an alias. A silent model change alters coach
# behaviour mid-cohort and invalidates the contamination audit.
#
# Accepted pinned Gemini identifiers end in an explicit version:
#   gemini-2.5-flash-001            (numbered)
#   gemini-1.5-flash-8b-20250827    (dated)
# Moving aliases and bare families are rejected at boot:
#   gemini-2.5-flash-latest   gemini-2.5-pro-preview
#   gemini-2.5-flash
#
# This documents the accepted pinned form, not a runtime default: leave
# AI_MODEL unset to stay on the deterministic path.
AI_MODEL=

# OPTIONAL: force the degradation level (L0..L3). Local and preview default to
# AI_LEVEL_PIN=L2, so the fallback path is what developers exercise daily.
# Do not change that default; unset AI_LEVEL_PIN only to follow production's
# automatic selection.
AI_LEVEL_PIN=

# Secret used to sign session cookies. Required for the invite/resume flow.
SESSION_SECRET=

# OPTIONAL: email provider key, only for resending lost invite links.
RESEND_API_KEY=